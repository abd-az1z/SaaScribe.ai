# =============================================================================
# SaaScribe.ai — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values below.
#   cp .env.example .env.local
#
# NEVER commit `.env.local` (it is gitignored). Values marked "public" are
# exposed to the browser (NEXT_PUBLIC_*); all others are server-only secrets.
# On Vercel, add every variable below under Settings → Environment Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# Clerk — Authentication
# Get from: https://dashboard.clerk.com → your app → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Firebase — Client SDK (browser)
# Get from: Firebase Console → Project Settings → General → Your apps →
#           Web app → SDK setup and configuration → Config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Same value as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET, used server-side.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com


# -----------------------------------------------------------------------------
# Firebase — Admin SDK (server)
# Get from: Firebase Console → Project Settings → Service Accounts →
#           Generate new private key (downloads a JSON file)
# NOTE: Paste the private key on ONE line with literal \n sequences and wrap
#       it in double quotes. The app converts \n back into real newlines.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...replace-me...\n-----END PRIVATE KEY-----\n"


# -----------------------------------------------------------------------------
# Stripe — Subscriptions & billing
# Get from: https://dashboard.stripe.com → Developers → API keys
# Price ID: Products → your Pro plan → the recurring price (price_...)
# Webhook secret: Developers → Webhooks → your endpoint → Signing secret
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# OpenAI — Embeddings & GPT-4o chat completions
# Get from: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Pinecone — Vector store for RAG
# API key:   https://app.pinecone.io → API Keys
# Index name: https://app.pinecone.io → Indexes (the name of your index)
# -----------------------------------------------------------------------------
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=your-index-name


# -----------------------------------------------------------------------------
# Neon Postgres — Contract Risk Lens (Drizzle ORM)
# Get from: https://console.neon.tech → your project → Connect →
#           copy the connection string
# After setting this, create the tables with: npx drizzle-kit push
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@your-host.neon.tech/dbname?sslmode=require
